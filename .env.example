# Copy to .env (never commit .env) and fill in.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: keep data outside the repo
# DATABASE_PATH=/path/to/db.sqlite3
# MEDIA_ROOT=/path/to/media
# Serving over HTTPS under a public domain:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_BEHIND_HTTPS_PROXY=1
# Public demo only: a shared account shown on the sign-in page
# QUIZBANK_DEMO_USERNAME=demo
# QUIZBANK_DEMO_PASSWORD=
